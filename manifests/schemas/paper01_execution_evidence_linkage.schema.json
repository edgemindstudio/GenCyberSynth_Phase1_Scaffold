{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustforge.local/schemas/paper01_execution_evidence_linkage.schema.json",
  "title": "TrustForge Paper 1 Execution-Evidence Linkage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment",
    "authoritative_result",
    "accepted_evaluation",
    "artifact_production",
    "historical_executions",
    "manifest_evidence",
    "synthetic_evidence",
    "checkpoint_evidence",
    "non_authoritative_aliases",
    "provenance_assertions",
    "source_inventory"
  ],
  "properties": {
    "schema_version": {
      "const": "trustforge.paper01.execution_evidence_linkage.v1"
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "dataset",
        "family",
        "seed",
        "budget_per_class",
        "historical_run_id"
      ],
      "properties": {
        "experiment_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer"
        },
        "budget_per_class": {
          "type": "integer",
          "minimum": 1
        },
        "historical_run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authoritative_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "table_path",
        "table_sha256",
        "row_key",
        "accepted_metric_match"
      ],
      "properties": {
        "status": {
          "const": "verified"
        },
        "table_path": {
          "type": "string",
          "minLength": 1
        },
        "table_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "row_key": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "accepted_metric_match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "summary_count"
          ],
          "properties": {
            "status": {
              "const": "exact"
            },
            "summary_count": {
              "const": 1
            }
          }
        }
      }
    },
    "accepted_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "execution",
        "accepted_summary"
      ],
      "properties": {
        "status": {
          "const": "verified"
        },
        "execution": {
          "$ref": "#/$defs/accepted_evaluation_execution"
        },
        "accepted_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "authority",
            "metric_match",
            "config_sha1_match_to_execution"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "(^|/)latest\\.json$"
              }
            },
            "authority": {
              "const": "accepted_timestamped_summary"
            },
            "metric_match": {
              "const": "exact"
            },
            "config_sha1_match_to_execution": {
              "const": true
            }
          }
        }
      }
    },
    "artifact_production": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "executions",
        "lineage_claim"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "strong_candidate",
            "observed",
            "unresolved"
          ]
        },
        "executions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_execution"
          }
        },
        "lineage_claim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "proven",
            "reason"
          ],
          "properties": {
            "level": {
              "enum": [
                "verified",
                "strong_candidate",
                "observed",
                "unresolved"
              ]
            },
            "proven": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "historical_executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/historical_execution"
      }
    },
    "manifest_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_specific",
        "shared_root"
      ],
      "properties": {
        "seed_specific": {
          "$ref": "#/$defs/manifest_entry"
        },
        "shared_root": {
          "$ref": "#/$defs/manifest_entry"
        }
      }
    },
    "synthetic_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "file_count",
        "layout",
        "layout_counts"
      ],
      "properties": {
        "status": {
          "enum": [
            "present",
            "absent",
            "unresolved"
          ]
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "layout": {
          "type": "string",
          "minLength": 1
        },
        "layout_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "checkpoint_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "file_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "present",
            "absent",
            "unresolved"
          ]
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "non_authoritative_aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_summary"
      ],
      "properties": {
        "latest_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present",
            "authority",
            "authoritative",
            "reason"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "authority": {
              "const": "none"
            },
            "authoritative": {
              "const": false
            },
            "reason": {
              "const": "compatibility_alias"
            }
          }
        }
      }
    },
    "provenance_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_summary_to_evaluation_execution",
        "accepted_summary_to_authoritative_result",
        "artifact_execution_to_surviving_artifacts"
      ],
      "properties": {
        "accepted_summary_to_evaluation_execution": {
          "$ref": "#/$defs/provenance_assertion"
        },
        "accepted_summary_to_authoritative_result": {
          "$ref": "#/$defs/provenance_assertion"
        },
        "artifact_execution_to_surviving_artifacts": {
          "$ref": "#/$defs/provenance_assertion"
        }
      }
    },
    "source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_version",
        "inventory_path"
      ],
      "properties": {
        "audit_version": {
          "const": "M6.4.1-v3.2"
        },
        "inventory_path": {
          "const": "studies/paper01_benchmark/audits/m6_4_1/paper01_execution_evidence_inventory.json"
        }
      }
    }
  },
  "$defs": {
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "task_id",
        "host",
        "config_sha1",
        "git_commit",
        "do_train",
        "do_synth",
        "do_eval",
        "stages",
        "log_path"
      ],
      "properties": {
        "job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "config_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "do_train": {
          "type": "boolean"
        },
        "do_synth": {
          "type": "boolean"
        },
        "do_eval": {
          "type": "boolean"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "log_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "accepted_evaluation_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "task_id",
        "host",
        "config_sha1",
        "git_commit",
        "do_train",
        "do_synth",
        "do_eval",
        "stages",
        "log_path"
      ],
      "properties": {
        "job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "config_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "do_train": {
          "type": "boolean"
        },
        "do_synth": {
          "type": "boolean"
        },
        "do_eval": {
          "const": true
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "log_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "task_id",
        "host",
        "config_sha1",
        "git_commit",
        "do_train",
        "do_synth",
        "do_eval",
        "stages",
        "log_path",
        "evidence_basis"
      ],
      "properties": {
        "job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "config_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "do_train": {
          "type": "boolean"
        },
        "do_synth": {
          "type": "boolean"
        },
        "do_eval": {
          "type": "boolean"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "log_path": {
          "type": "string",
          "minLength": 1
        },
        "evidence_basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "historical_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "role",
        "config_sha1",
        "git_commit"
      ],
      "properties": {
        "job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "historical_execution",
              "artifact_producer",
              "artifact_producer_candidate",
              "accepted_evaluator"
            ]
          }
        },
        "config_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "do_train": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "do_synth": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "do_eval": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "log_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "manifest_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "path"
      ],
      "properties": {
        "status": {
          "enum": [
            "present",
            "absent",
            "unresolved"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority": {
          "enum": [
            "historical_seed_manifest",
            "compatibility_evidence",
            "none"
          ]
        }
      }
    },
    "provenance_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "strong_candidate",
            "observed",
            "unresolved"
          ]
        },
        "basis": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
